          ],
          "Assign": {
            "erreur": "{% $states.errorOutput %}"
          },
          "Next": "Set Metadata URLs - relire"
        }
      ]
    },
    "Loop - iterer": {
      "Type": "Map",
      "Items": "{% $http_request_mseo2m4r_1.ResponseBody.objects %}",
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
