            "Default": "Fin du corps"
          },
          "Check Asset": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "aps-essences — le module builder-essences.js, tel quel. Ne PAS le réécrire : ces URL sont livrées au partenaire puis vérifiées par APS, deux implémentations qui divergent contrôleraient une autre adresse que celle qu'elles ont envoyée. Liste AUSSI le bucket (identifiants de la connexion APS) : l'intégration S3 native signe avec le rôle d'exécution, donc elle ne sait pas atteindre le bucket d'un client.",
            "Arguments": {
              "FunctionName": "aps-essences",
              "Payload": {
                "essences": [],
                "typeCollection": "{% $TypeCollection %}",
                "connexionId": "cmqp7eg510003q4u5l0qlpidq",
                "objectKey": "AmazonPrime/{ancestorPath}/{filebase(item.title)}"
              }
            },
            "Assign": {
              "deliver_mseozji7_4": "{% $states.result.Payload %}"
            },
            "Next": "Check Asset - quel port"
          },
          "Action": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
              "ApiEndpoint": "{% 'https://app.iconik.io/API/files/v1/assets/' & $item.id & '/export_locations/f51748d2-5db4-11f1-bdc2-52e9b30fbd6f/' %}",
              "Method": "POST",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/435ccfa9-00d5-4e94-bc14-0ddcb35bcfaf"
              },
              "RequestBody": {
                "file_name": "{% $replace($replace($ancestorPath & '/' & $replace($item.title, /\\.[^.]*$/, ''), /\\s+/, '_'), /[^a-zA-Z0-9_\\-\\/]/, '') %}"
              }
            },
            "Assign": {
              "http_request_mserkbl2_10": "{% $states.result %}"
            },
            "Next": "Wait"
          },
          "Wait - attendre": {
            "Type": "Wait",
            "Seconds": 20,
            "Next": "Wait"
          },
          "Wait - termine": {
            "Type": "Choice",
            "Choices": [
              {
                "Condition": "{% $wait_msermvge_11_sonde.ResponseBody.status = 'FINISHED' %}",
                "Next": "Recheck"
              }
            ],
            "Default": "Wait - attendre"
          },
          "Wait": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Arguments": {
              "ApiEndpoint": "{% 'https://app.iconik.io/API/jobs/v1/jobs/' & $http_request_mserkbl2_10.ResponseBody.job_id & '/' %}",
              "Method": "GET",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/435ccfa9-00d5-4e94-bc14-0ddcb35bcfaf"
              }
            },
            "Assign": {
              "wait_msermvge_11_sonde": "{% $states.result %}"
            },
            "Next": "Wait - termine",
            "Catch": [
              {
                "ErrorEquals": [
                  "States.ALL"
                ],
                "Assign": {
                  "erreur": "{% $states.errorOutput %}"
                },
                "Next": "Recheck"
              }
            ]
          },
          "Recheck": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Comment": "aps-essences — le module builder-essences.js, tel quel. Ne PAS le réécrire : ces URL sont livrées au partenaire puis vérifiées par APS, deux implémentations qui divergent contrôleraient une autre adresse que celle qu'elles ont envoyée. Liste AUSSI le bucket (identifiants de la connexion APS) : l'intégration S3 native signe avec le rôle d'exécution, donc elle ne sait pas atteindre le bucket d'un client.",
            "Arguments": {
              "FunctionName": "aps-essences",
              "Payload": {
                "essences": [],
                "typeCollection": "{% $TypeCollection %}",
                "connexionId": "cmqp7eg510003q4u5l0qlpidq",
                "objectKey": "AmazonPrime/{ancestorPath}/{filebase(item.title)}"
              }
            },
            "Assign": {
              "deliver_mseozji7_4_copie_mserwa3b_1": "{% $states.result.Payload %}"
            },
            "Next": "Fin du corps"
          },
          "Element courant": {
            "Type": "Pass",
            "Comment": "L'élément de ce tour de boucle, nommé pour que le corps le lise comme « item » — le nom que le pivot emploie. Remplace la clé item de l'ItemSelector.",
            "Assign": {
              "item": "{% $states.input %}"
            },
            "Next": "Video Info"
          }
        }
      },
      "Next": "Set Metadata URLs - relire"
    },
    "Loop": {
      "Type": "Pass",
      "Comment": "CE QUE LA BOUCLE EMPRUNTE AU DEHORS. En JSONata une portée interne lit les variables de la portée extérieure : il suffit donc de les nommer ici. Remplace l'ItemSelector, qui cachait le même contrat dans la définition du Map.",
      "Assign": {
        "TypeCollection": "{% $http_request_msdcfihl_3.ResponseBody.objects[0].metadata.TypeCollection %}"
      },
      "Next": "Loop - iterer"
    },
    "Create ID Generator": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:eu-west-3:632075073384:function:aps-http_request",
      "Comment": "FONCTION À ÉCRIRE — le registre et le compteur vivent dans la base d'APS. Aucune cible ne les porte : il faut et le code, et une table (DynamoDB) pour l'état",
