        "Method": "GET",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/435ccfa9-00d5-4e94-bc14-0ddcb35bcfaf"
        }
      },
      "Assign": {
        "http_request_msdd3jip_1": "{% $states.result %}"
      },
      "Next": "Set Bayard ID - ecrire",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Assign": {
            "http_request_msdd3jip_1": "{% { \"ResponseBody\": {} } %}"
          },
          "Next": "Set Bayard ID - ecrire"
        }
      ]
    },
    "Metadonnees de livraison - metadonnees": {
      "Type": "Task",
      "Resource": "arn:aws:states:::http:invoke",
      "Arguments": {
        "ApiEndpoint": "{% 'https://app.iconik.io/API/metadata/v1/assets/' & $http_request_assetedito_1.ResponseBody.objects[0].id & '/views/64485176-5499-11f1-b566-6af3f91c030b/' %}",
        "Method": "GET",
        "Authentication": {
          "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/435ccfa9-00d5-4e94-bc14-0ddcb35bcfaf"
        }
      },
      "Assign": {
        "http_request_mdlivraison_1_metadonnees": "{% $states.result %}"
      },
      "Next": "Metadonnees de livraison - quel port"
    },
    "Metadonnees de livraison - quel port": {
