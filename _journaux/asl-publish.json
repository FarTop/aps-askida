            "ResultPath": "$.s3",
            "Next": "Check Asset - quel port"
          },
          "Action": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Parameters": {
              "ApiEndpoint": "https://app.iconik.io/API/",
              "Method": "GET",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/00000000-0000-0000-0000-000000000000"
              }
            },
            "ResultPath": "$.http_request_mserkbl2_10",
            "Next": "Wait"
          },
          "Wait - attendre": {
            "Type": "Wait",
            "Seconds": 20,
            "Next": "Wait"
          },
          "Wait - termine": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.sonde.ResponseBody.status",
                "StringEquals": "FINISHED",
                "Next": "Recheck"
              }
            ],
            "Default": "Wait - attendre"
          },
          "Wait": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Parameters": {
              "ApiEndpoint": "/API/jobs/v1/jobs/{exportJobId}/",
              "Method": "GET",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/00000000-0000-0000-0000-000000000000"
              }
            },
            "ResultPath": "$.sonde",
            "Next": "Wait - termine",
