        },
        "RequestBody": {
          "metadata_values": "{% $merge([$http_request_msdd3jip_1.ResponseBody.metadata_values, {'BayardID': {'field_values': [{'value': $http_request_mseo2m4r_1.ResponseBody.objects[0].metadata.generated_id}]}}]) %}"
        }
      },
      "Assign": {
        "http_request_msdd3jip_1_ecrire": "{% $states.result %}"
