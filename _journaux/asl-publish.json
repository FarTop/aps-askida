            ],
            "Default": "Check Asset"
          },
          "Video Info": {
            "Type": "Task",
            "Resource": "arn:aws:states:::http:invoke",
            "Comment": "GABARIT GÉNÉRIQUE — l'appel de « iconik.fetch » n'est pas encore déclaré dans le catalogue.",
            "Arguments": {
              "ApiEndpoint": "https://app.iconik.io/API/",
              "Method": "GET",
              "Authentication": {
                "ConnectionArn": "arn:aws:events:eu-west-3:632075073384:connection/aps-iconik/435ccfa9-00d5-4e94-bc14-0ddcb35bcfaf"
