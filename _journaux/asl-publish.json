    "Loop": {
      "Type": "Map",
      "ItemsPath": "$.items",
      "ItemSelector": {
        "item.$": "$$.Map.Item.Value",
        "ancestorPath.$": "$.ancestorPath"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "Video Info",
        "States": {
          "Fin du corps": {
            "Type": "Succeed"
          },
          "Video Info - quel port": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.port",
                "StringEquals": "not_found",
